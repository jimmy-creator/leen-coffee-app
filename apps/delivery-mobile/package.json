{
  "name": "@leen/delivery-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas-build-post-install": "pnpm --filter @leen/types --filter @leen/lib --filter @leen/i18n --filter @leen/api-client run build",
    "tunnel": "expo start --tunnel --dev-client"
