# ---------------------------------------------------------------------------
# Leen Coffee — environment
#
# The Supabase URL and publishable (anon) key are safe in client bundles: every
# table is behind RLS and the key carries no privileges of its own. The service
# role key and the database password are NOT — they belong only in Edge Function
# secrets and in your local .env.local, which git ignores.
# ---------------------------------------------------------------------------

# Web apps (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Mobile apps (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Server only — never expose to a browser or an app bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase CLI work only.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Mapbox — public (pk.) token, safe in a client bundle.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-public-mapbox-token
